{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Living ancient cities: silent Architects who tend the sculk ritual, calm the Warden with a melody and slowly decline, plus the infected variants of their descendants.",
  "authors": [
    "Vortex_So"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.vortexso.guest_architects.fabric.GuestArchitectsFabric"
    ],
    "client": [
      "com.vortexso.guest_architects.fabric.GuestArchitectsFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25",
    "fabric-api": "*",
    "forgeconfigapiport": "*",
    "guest_core": "*"
  }
}
