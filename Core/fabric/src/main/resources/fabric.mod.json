{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Shared library for the Guest addons: calendar, deterministic world primitives, weather/wildlife read-only contracts, sparse world history, cross-addon events and debug tools. Adds no gameplay content.",
  "authors": [
    "Vortex_So"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.vortexso.guest_core.fabric.GuestCoreFabric"
    ],
    "client": [
      "com.vortexso.guest_core.fabric.GuestCoreFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25",
    "fabric-api": "*",
    "forgeconfigapiport": "*"
  }
}
