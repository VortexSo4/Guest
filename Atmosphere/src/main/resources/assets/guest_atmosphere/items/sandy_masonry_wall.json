      {
        "when": "mud_bricks",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_mud_bricks_wall_inventory"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "guest_atmosphere:block/sandy_cobblestone_wall_inventory"
    }
  }
}
