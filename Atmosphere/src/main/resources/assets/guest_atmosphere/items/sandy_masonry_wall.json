{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:block_state",
    "block_state_property": "base",
    "cases": [
      {
        "when": "cobblestone",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_cobblestone_wall_inventory"
        }
      },
      {
        "when": "mossy_cobblestone",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_mossy_cobblestone_wall_inventory"
        }
      },
      {
        "when": "stone_bricks",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_stone_bricks_wall_inventory"
        }
      },
      {
        "when": "mossy_stone_bricks",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_mossy_stone_bricks_wall_inventory"
        }
      },
      {
        "when": "bricks",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_bricks_wall_inventory"
        }
      },
      {
        "when": "cobbled_deepslate",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_cobbled_deepslate_wall_inventory"
        }
      },
      {
        "when": "deepslate_bricks",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_deepslate_bricks_wall_inventory"
        }
