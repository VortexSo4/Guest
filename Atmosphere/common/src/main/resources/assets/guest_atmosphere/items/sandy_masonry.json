{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:block_state",
    "block_state_property": "base",
    "cases": [
      {
        "when": "cobblestone",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_cobblestone"
        }
      },
      {
        "when": "mossy_cobblestone",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_mossy_cobblestone"
        }
      },
      {
        "when": "stone",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_stone"
        }
      },
      {
        "when": "stone_bricks",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_stone_bricks"
        }
      },
      {
        "when": "mossy_stone_bricks",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_mossy_stone_bricks"
        }
      },
      {
        "when": "cracked_stone_bricks",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_cracked_stone_bricks"
        }
      },
      {
        "when": "chiseled_stone_bricks",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_chiseled_stone_bricks"
        }
      },
      {
        "when": "bricks",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_bricks"
        }
      },
      {
        "when": "cobbled_deepslate",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_cobbled_deepslate"
        }
      },
      {
        "when": "deepslate_bricks",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_deepslate_bricks"
        }
      },
      {
        "when": "mud_bricks",
        "model": {
          "type": "minecraft:model",
          "model": "guest_atmosphere:block/sandy_mud_bricks"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "guest_atmosphere:block/sandy_cobblestone"
    }
